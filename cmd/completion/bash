#!/usr/bin/env bash

_monit_exporter_completion() {
    local current="${COMP_WORDS[COMP_CWORD]-}" candidate description
    COMPREPLY=()
    while IFS=$'\t' read -r candidate description; do
        case "$candidate" in
        :0)
            while IFS= read -r candidate; do
                COMPREPLY+=("$candidate")
            done < <(compgen -f -- "$current")
            ;;
        :*) ;;
        *)
            if [[ "${COMP_TYPE-}" == 63 && -n "$description" ]]; then
                COMPREPLY+=("$candidate  ($description)")
            else
                COMPREPLY+=("$candidate")
            fi
            ;;
        esac
    done < <("${COMP_WORDS[0]}" __COMPLETE_COMMAND__ "${COMP_WORDS[@]:1:COMP_CWORD-1}" "$current")
}
complete -F _monit_exporter_completion monit-exporter
